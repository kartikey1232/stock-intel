# Copy to .env and fill in real values. Never commit .env.

# Phase 6: Telegram alerts. Token from @BotFather; chat id from
# `uv run python -m delivery.telegram --find-chat` after messaging the bot.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Phase 4: key for hashing social post authors (never stored in plain text).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SOCIAL_HASH_KEY=replace-with-64-random-hex-characters

# Phase 4: Reddit social signals (not used until Reddit approves an app)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# Phase 2: news summarisation / sentiment
ANTHROPIC_API_KEY=your-anthropic-api-key

# Database file (relative paths resolve from the project root)
DB_PATH=data/stock_intel.db
